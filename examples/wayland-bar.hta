<!DOCTYPE html>
<!--
  UC2 — a Wayland top bar: hostname, battery, and a clock.

  Exercises: window.mode "layer" (wlr-layer-shell), exclusive zone, os, dbus.

  RUNNING THIS: layer-shell needs a Wayland surface, and the engine backend that ships
  today embeds into an X11 window (see PRD §6.1 and the htmlapp-engine crate docs).
  So `htmlapp examples/wayland-bar.hta` will refuse with an explanation rather than
  open something broken. `htmlapp inspect examples/wayland-bar.hta` still works, and
  this document is ready for the offscreen backend described in §6.3.
-->
<html>
<head>
<meta charset="utf-8">
<script type="application/htmlapp+json">
{
  "name": "Bar",
  "id": "dev.htmlapp.bar",
  "version": "1.0.0",
  "window": {
    "mode": "layer",
    "layer": "top",
    "anchor": ["top", "left", "right"],
    "exclusive_zone": 34,
    "keyboard_interactivity": "none",
    "output": "primary",
    "background": "transparent",
    "height": 34
  },
  "permissions": {
    "dbus":  { "session": true, "system": true,
               "destinations": ["org.freedesktop.UPower", "org.freedesktop.NetworkManager"] },
    "os":    true,
    "layer": true
  }
}
</script>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0; height: 34px; display: flex; align-items: center; gap: 1rem;
    padding: 0 .75rem; font: 12px/1 system-ui, sans-serif;
    background: rgba(20, 22, 26, .85); color: #e6e8ec;
    backdrop-filter: blur(12px);
  }
  .spacer { flex: 1; }
  .chip { padding: .25rem .5rem; border-radius: 5px; background: rgba(255,255,255,.07); }
  #clock { font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
  <span class="chip" id="host">…</span>
  <span class="spacer"></span>
  <span class="chip" id="battery"></span>
  <span class="chip" id="clock"></span>

<script type="module">
  const $ = id => document.getElementById(id);

  const tick = () => {
    $('clock').textContent = new Date().toLocaleString(undefined,
      { weekday: 'short', hour: '2-digit', minute: '2-digit' });
  };
  tick();
  setInterval(tick, 1000);

  const info = await htmlapp.os.info();
  $('host').textContent = info.hostname || info.distro || 'linux';

  async function battery() {
    const state = await htmlapp.os.battery();
    $('battery').textContent = state
      ? `${Math.round(state.percentage)}%${state.charging ? ' (charging)' : ''}`
      : '';
  }
  battery();
  setInterval(battery, 30_000);

  // The bar can move itself between outputs and change its reserved space at runtime.
  htmlapp.on('layer:outputs', outputs => {
    console.log('outputs changed', outputs.map(o => o.name));
  });
</script>
</body>
</html>
