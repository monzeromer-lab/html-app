<!DOCTYPE html>
<!--
  the native views design — a native GPUI view placed inline in HTML layout.

  The <htmlapp-view> element is a transparent placeholder that takes part in normal
  flow. A ResizeObserver reports its rect over the bridge; the host shapes the page's
  window to exclude that rectangle and paints a real GPUI element there instead.

  So the pink border below is HTML, and everything inside it is not.
-->
<html>
<head>
<meta charset="utf-8">
<script type="application/htmlapp+json">
{
  "name": "Native View",
  "id": "dev.htmlapp.nativeview",
  "version": "1.0.0",
  "window": { "title": "Native View", "width": 900, "height": 620 }
}
</script>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body {
    font: 14px/1.6 system-ui, sans-serif; margin: 0; padding: 1.5rem;
    height: 100vh; display: flex; flex-direction: column; gap: 1rem;
    background: #101216; color: #e6e8ec;
  }
  h1 { margin: 0; font-size: 1.2rem; }
  p { margin: 0; opacity: .75; }
  .frame {
    flex: 1; min-height: 0;
    border: 2px solid #ff6bcb; border-radius: 8px; padding: 2px;
  }
  htmlapp-view { display: block; width: 100%; height: 100%; }
  code { background: #ffffff14; padding: .1em .4em; border-radius: 4px; }
</style>
</head>
<body>
  <h1>This heading is HTML</h1>
  <p>
    Everything inside the pink border is a native GPUI view, drawn by the host through a
    hole shaped in the page's own window. Rendering a table this way costs one row of
    elements per visible line, not one per row of data.
  </p>

  <div class="frame">
    <htmlapp-view kind="table" id="rows"></htmlapp-view>
  </div>

  <p id="status">Filling the table…</p>

<script type="module">
  const rows = htmlapp.view('rows');

  await rows.call('setColumns', {
    columns: [
      { name: 'id', width: 90 },
      { name: 'level', width: 90 },
      { name: 'message' },
    ],
  });

  // A hundred thousand rows, appended in batches. The bridge transport is explicit that one giant payload is
  // The thing to avoid — the bridge is not a place to put ten megabytes of JSON at once.
  const levels = ['INFO', 'WARN', 'ERROR', 'DEBUG'];
  const TOTAL = 100_000;
  const BATCH = 2_000;

  for (let start = 1; start <= TOTAL; start += BATCH) {
    const batch = [];
    for (let i = start; i < start + BATCH && i <= TOTAL; i++) {
      batch.push({
        id: i,
        level: levels[i % levels.length],
        message: `event ${i} — the host renders only the rows you can see`,
      });
    }
    await rows.call('append', { rows: batch });
  }

  const count = await rows.call('count', {});
  document.getElementById('status').textContent =
    `${count.toLocaleString()} rows in the native view. The heading and this line are HTML.`;
</script>
</body>
</html>
